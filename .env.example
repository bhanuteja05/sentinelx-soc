# Copy this file to .env and fill in local values.
# Do not commit real passwords, API keys, tokens, or secrets.

# Application
APP_ENV=development
LOG_LEVEL=INFO
SENTINELX_ENV=development
SENTINELX_HOST=127.0.0.1
SENTINELX_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173

# PostgreSQL (application data)
# Host mapping is 127.0.0.1:5433 -> container 5432
# docker-compose backend overrides POSTGRES_HOST=db and POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=<replace-me>

# Frontend / reverse-proxy (planned)
BACKEND_PROXY_TARGET=http://backend:8000
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173

# Wazuh (Docker single-node). Host dashboard is https://127.0.0.1:8443
# Indexer is not published to the host; in-stack URL is https://wazuh.indexer:9200
#
# Password constraints:
#   WAZUH_API_PASSWORD  - must match the hash in internal_users.yml for the
#                         wazuh-wui user AND the plaintext in wazuh_dashboard/wazuh.yml
#                         is overridden at runtime by this variable via API_PASSWORD in
#                         infrastructure/wazuh/docker-compose.yml.
#   WAZUH_INDEXER_PASSWORD - must match the bcrypt hash for 'admin' in
#                         infrastructure/wazuh/config/wazuh_indexer/internal_users.yml
#   WAZUH_DASHBOARD_PASSWORD - must match the bcrypt hash for 'kibanaserver' in
#                         infrastructure/wazuh/config/wazuh_indexer/internal_users.yml
#
# Never commit real passwords to version control.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=<replace-me>
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=<replace-me>
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=<replace-me>
