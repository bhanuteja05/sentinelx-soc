# ==============================================================================
# SentinelX SOC Lab — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure local values before starting services:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit real passwords, API tokens, JWT secrets, or private keys to git.
# The .env file is gitignored by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Environment
# ------------------------------------------------------------------------------
APP_ENV=development
SENTINELX_ENV=development
LOG_LEVEL=INFO
SENTINELX_HOST=127.0.0.1
SENTINELX_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Authentication & RBAC (JWT & Password Hashes)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-secure-random-64-character-hex-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial bootstrap operator credentials for backend/scripts/seed_users.py
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-admin-password
DEFAULT_ANALYST_PASSWORD=change-me-to-a-strong-analyst-password

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Application Store)
# ------------------------------------------------------------------------------
# Host port mapping is 127.0.0.1:5433 -> container 5432 (avoids local port 5432 collisions)
# When running within Docker Compose, backend overrides POSTGRES_HOST=db and PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me-to-a-strong-postgres-password

# ------------------------------------------------------------------------------
# 4. Frontend & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
BACKEND_PROXY_TARGET=http://backend:8000
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 5. Wazuh SIEM Manager & Indexer Connectivity
# ------------------------------------------------------------------------------
# Manager API: published on host port 55000 (accessible via host.docker.internal in Docker Desktop)
# Indexer OpenSearch: port 9200 (internal sentinelx-siem network only)
# Dashboard: published on host port https://127.0.0.1:8443
#
# Password constraints:
#   WAZUH_API_PASSWORD       - Plaintext password for 'wazuh-wui' user
#   WAZUH_INDEXER_PASSWORD   - Plaintext password matching the bcrypt hash for 'admin'
#                              in infrastructure/wazuh/config/wazuh_indexer/internal_users.yml
#   WAZUH_DASHBOARD_PASSWORD - Plaintext password matching the bcrypt hash for 'kibanaserver'
#                              in infrastructure/wazuh/config/wazuh_indexer/internal_users.yml
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me-wazuh-api-password

WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me-wazuh-indexer-password

WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=change-me-wazuh-dashboard-password

# ------------------------------------------------------------------------------
# 6. Wazuh Alert Ingestion Background Scheduler
# ------------------------------------------------------------------------------
WAZUH_TIMEOUT=10.0
WAZUH_VERIFY_SSL=false
WAZUH_INGEST_ENABLED=true
WAZUH_INGEST_INTERVAL_SECONDS=30.0
WAZUH_INGEST_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# 7. Defensive Active Response & Containment Safety
# ------------------------------------------------------------------------------
# Fail-closed master killswitch for active response execution.
# Set to 'false' (default) to disable all containment execution endpoints.
# Set to 'true' only in verified SOC lab environments.
RESPONSE_ENABLED=false

# Comma-separated list of additional protected IP addresses/hostnames that can
# never be targeted under any circumstances (loopback & 0.0.0.0 are always blocked).
RESPONSE_PROTECTED_TARGETS=192.168.1.1,gateway.local,ad.corp.local
