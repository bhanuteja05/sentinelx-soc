# Copy this file to .env and fill in local values.
# Do not commit real passwords, API keys, tokens, or secrets.

# Application
SENTINELX_ENV=development
SENTINELX_HOST=127.0.0.1
SENTINELX_PORT=8000

# PostgreSQL (application data — planned)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=<replace-me>

# Wazuh API (planned)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=<replace-me>
WAZUH_API_PASSWORD=<replace-me>
WAZUH_INDEXER_URL=https://localhost:9200

# Frontend (planned)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8000
